{
  "name": "zwave-associations",
  "version": "0.1.0",
  "description": "Declarative association manager for Z-Wave companion / 3-way switches, driven by the zwave-js-server API.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "zwave-associations": "dist/server.js",
    "zwave-assoc": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "gangs.example.yaml",
    "config/config.example.json",
    "README.md"
  ],
  "scripts": {
    "dump": "node src/cli.ts dump",
    "plan": "node src/cli.ts plan",
    "apply": "node src/cli.ts apply",
    "reconcile": "node src/cli.ts reconcile",
    "serve": "node src/server/index.ts",
    "start": "node dist/server.js",
    "build": "esbuild server=src/server/index.ts cli=src/cli.ts --bundle --platform=node --format=esm --outdir=dist --packages=external",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
